# StudyMate BD - Supabase Configuration
# Obtain these free credentials from your Supabase Project: Project Settings -> API
# Note: For Vite apps, environment variables must start with VITE_ to be accessible in the browser.

# 1. Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# 2. Your Supabase anon/publishable public key (Safe for client-side use with Row Level Security)
# NEVER put your 'service_role' secret key here!
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
